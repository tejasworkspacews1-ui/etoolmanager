# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/

# Type checking / linters
.mypy_cache/
.pytype/
.pyre/
.dmypy.json
dmypy.json

# Runtime / logs
*.log
logs/
etoolmanager/**/*.log

# Reports (generated, keep sample reports manually)
reports/*.md
reports/*.json
!reports/report-sample.md
!reports/report-sample.json

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# Jupyter
